# Copy to .env before running `docker compose up`. Local development only — never commit the
# real .env file (it is git-ignored) and never reuse this password anywhere but your own machine.
SQLSERVER_SA_PASSWORD=REPLACE_WITH_your_own_str0ng_P@ssw0rd

# From the API App Registration — see docs/security/entra-id-setup.md. Only Tenant ID and the API's own
# Client ID are needed here; the API only validates tokens, it never requests one, so no secret.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Optional: only needed to enable "add user from the Entra ID directory". Requires adding the Graph
# application permission User.Read.All (with admin consent) and a client secret to the SAME API App
# Registration above — see docs/security/entra-id-setup.md. Leave empty to disable the feature safely.
GRAPH_CLIENT_SECRET=

# Optional: only needed to enable assignment notification emails via Microsoft Graph's sendMail. A real
# mailbox (needs a Microsoft 365 license) plus the extra Graph application permission Mail.Send (with
# admin consent) on the same API App Registration — see docs/security/entra-id-setup.md §1b. Leave empty
# to disable email delivery safely.
GRAPH_SENDER_MAILBOX=

# From the Web App Registration — used by the frontend's login flow.
ENTRA_WEB_CLIENT_ID=
ENTRA_WEB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# The externally-visible URL of the frontend — must match a redirect URI on the Web App Registration.
AUTH_URL=http://localhost:3000
